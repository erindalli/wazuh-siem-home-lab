<!--
  Custom Wazuh detection rules for this lab.
  Location on the Wazuh Manager VM: /var/ossec/etc/rules/local_rules.xml

  Two independent rule groups:
    1. dvwa      - detects brute-force login attempts against DVWA's custom
                   login form (no built-in Wazuh rule covers this, since it's
                   an application-specific endpoint).
    2. cowrie    - detects and classifies activity captured by the Cowrie
                   SSH honeypot (connection, login success/failure, command
                   execution, and file downloads), parsed from Cowrie's
                   structured JSON log.
-->

<group name="dvwa,web,attack,">

  <rule id="100100" level="5">
    <if_sid>31100</if_sid>
    <url>vulnerabilities/brute</url>
    <description>DVWA Brute Force login attempt detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>DVWA Brute Force Attack Detected - multiple login attempts from same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>


<group name="cowrie,honeypot,">

  <!-- Base rule: matches any Cowrie JSON event. Level 0 = non-alerting,
       exists only so the rules below can attach to it via <if_sid>. -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie honeypot event.</description>
  </rule>

  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie\.session\.connect$</field>
    <description>Attacker connected to Cowrie honeypot from $(src_ip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <rule id="100202" level="3">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Failed login attempt against Cowrie honeypot</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100203" level="8">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie\.login\.success$</field>
    <description>Attacker gained shell access to Cowrie honeypot</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100204" level="6">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie\.command\.input$</field>
    <description>Command executed by attacker in Cowrie honeypot session</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100205" level="10">
    <if_sid>100200</if_sid>
    <field name="eventid">^cowrie\.session\.file_download$</field>
    <description>File downloaded inside Cowrie honeypot session -
    possible malware sample captured</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

</group>
